    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
