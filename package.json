{
  "name": "resume-helper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply resume-helper --local",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "biome check . && pnpm lint:fsd",
    "check:write": "biome check --write .",
    "lint:fsd": "steiger src"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.6.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@reatom/core": "^1001.3.0",
    "@reatom/react": "^1001.0.1",
    "@tanstack/react-virtual": "^3.14.11",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.2",
    "lucide-react": "^1.42.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.12",
    "@cloudflare/vite-plugin": "^1.54.5",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@playwright/test": "^1.63.0",
    "@reatom/vite": "^1001.0.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
